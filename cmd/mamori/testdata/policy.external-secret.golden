apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: mamori-managed-secrets
spec:
  secretStoreRef:
    name: REPLACE_ME_SECRET_STORE
    kind: SecretStore
  target:
    name: mamori-managed-secrets
  data:
    - secretKey: aws-sm-api
      remoteRef:
        key: prod/api
    - secretKey: aws-sm-db
      remoteRef:
        key: prod/db
    - secretKey: aws-ps-config
      remoteRef:
        key: prod/app/config
    - secretKey: gcp-sm-db-password
      remoteRef:
        key: db-password
