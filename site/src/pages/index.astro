---
import Layout from "../layouts/Layout.astro";
import ReconcileDemo from "../components/ReconcileDemo.astro";
import Seigaiha from "../components/Seigaiha.astro";
import Omamori from "../components/Omamori.astro";

const repo = "https://github.com/xavidop/mamori";
const base = import.meta.env.BASE_URL;
const docs = `${base}docs`;

const features = [
  {
    k: "01",
    t: "Typed loading",
    d: "One struct, tag-driven, many sources. A generics API - Load[T] and Watch[T] - decodes and validates into your own types. No stringly-typed lookups.",
  },
  {
    k: "02",
    t: "Runtime reconciliation",
    d: "Native watch where the backend supports it - Kubernetes informers, Consul blocking queries, fsnotify - polling with jitter everywhere else, and lease-aware refresh for Vault.",
  },
  {
    k: "03",
    t: "Atomic & gated",
    d: "A bad update never goes live. Validation rejects it, and you can add your own check on top: try the new credential, and say no if it fails. Until then your app keeps serving the last good config.",
  },
  {
    k: "04",
    t: "Secret hygiene",
    d: "secret.String redacts itself in logs, fmt, and JSON. Only Reveal() exposes the value - and a shipped go vet analyzer flags sensitive refs stored in plain strings.",
  },
];

// Providers are summarized on the landing by category; the full gallery lives in
// the docs. Each card links to a representative provider page.
const categories = [
  {
    name: "Local sources",
    count: 5,
    items: "env · dotenv · file · exec · Viper",
    href: `${base}docs/providers/env`,
  },
  {
    name: "Secret managers",
    count: 8,
    items: "AWS · Vault · GCP · Azure · Doppler · 1Password · SOPS",
    href: `${base}docs/providers/aws`,
  },
  {
    name: "Feature flags",
    count: 9,
    items: "LaunchDarkly · Unleash · Flagsmith · ConfigCat · Split · GrowthBook · Flipt · GO Feature Flag · OpenFeature",
    href: `${base}docs/providers/launchdarkly`,
  },
  {
    name: "Databases",
    count: 7,
    items: "Postgres · MySQL · SQLite · MongoDB · Redis · DynamoDB · Cosmos",
    href: `${base}docs/providers/postgres`,
  },
  {
    name: "KV, app config & Kubernetes",
    count: 6,
    items: "Consul · etcd · AWS AppConfig · Azure AppConfig · Kubernetes Secret · ConfigMap",
    href: `${base}docs/providers/kubernetes`,
  },
  {
    name: "Object storage & Firebase",
    count: 6,
    items: "S3 · GCS · Azure Blob · Firestore · Firebase RTDB · Remote Config",
    href: `${base}docs/providers/s3`,
  },
];
const totalProviders = categories.reduce((n, c) => n + c.count, 0);

// The operational layer beyond loading: serve, inspect, observe, and hand to an
// agent. Each card links to its docs.
const operational = [
  {
    t: "Config server",
    d: "A read-through fan-out: one process holds the credentials and watches each upstream once, while every other service reads values by name over a Unix socket or TLS, behind mandatory policy and audit.",
    href: `${base}docs/server`,
    cta: "Config server",
  },
  {
    t: "A real CLI",
    d: "explain, schema, and policy read your source statically; doctor and status probe a running process with distinct exit codes, so a script can tell a broken config from one it cannot reach.",
    href: `${base}docs/cli`,
    cta: "CLI",
  },
  {
    t: "Health & telemetry",
    d: "See every field's health right now, or run the same check in CI before you deploy. Logs, metrics and traces cover what happened over time. The OpenTelemetry and Prometheus bridges are separate modules, so neither lands in your build unless you ask.",
    href: `${base}docs/observability`,
    cta: "Health & telemetry",
  },
  {
    t: "Built for agents",
    d: "An installable agent skill and an llms.txt, so your coding agent can wire mamori and load the whole documentation from a single URL.",
    href: `${base}docs/skill`,
    cta: "Agent skill",
  },
];
---

<Layout>
  <!-- ░░ HERO ░░ -->
  <section class="hero">
    <Seigaiha />
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">守り · config &amp; secrets for go</span>
        <h1 class="hero__title">Secrets that<br /><em>reconcile</em> themselves.</h1>
        <p class="hero__lede">
          <strong>mamori</strong> loads configuration and secrets from anywhere into typed,
          validated Go structs - then watches every source and reconciles changes at runtime.
          Rotate a database password upstream; your pool rotates too. <em>No restart.</em>
        </p>

        <div class="hero__cta">
          <a class="btn btn--primary" href={docs}>Read the docs →</a>
          <a class="btn btn--ghost" href={repo} target="_blank" rel="noopener">GitHub ↗</a>
        </div>

        <div class="aud" role="tablist" aria-label="Audience">
          <button class="aud__btn aud__btn--on" data-aud-btn="humans" role="tab" aria-selected="true">For humans</button>
          <button class="aud__btn" data-aud-btn="agents" role="tab" aria-selected="false">For agents</button>
        </div>

        <div data-aud-panel="humans">
          <div class="hero__install">
            <code>go get github.com/xavidop/mamori</code>
          </div>
        </div>

        <div data-aud-panel="agents" hidden>
          <p class="hero__aud-intro">
            Point your coding agent at mamori - install the skill, or hand it the whole
            documentation as one file. Works with Claude Code, Cursor, Copilot, and more.
          </p>
          <div class="agent-card card">
            <p class="agent-card__label">Add the agent skill</p>
            <div class="hero__install"><code>npx skills add xavidop/mamori</code></div>
            <p class="agent-card__label">Or paste this prompt</p>
            <div class="hero__install hero__install--prompt">
              <code>Add mamori to my Go project. Docs: https://mamorigo.dev/llms.txt</code>
            </div>
            <div class="agent-card__links">
              <a href={`${base}llms.txt`}>llms.txt</a>
              <a href={`${base}llms-full.txt`}>llms-full.txt</a>
              <a href={`${base}docs/skill`}>Agent skill guide →</a>
            </div>
          </div>
        </div>
      </div>
      <div class="hero__demo">
        <ReconcileDemo />
      </div>
    </div>
  </section>

  <!-- ░░ CONCEPTS ░░ -->
  <section class="section" id="concepts">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">principles</span>
        <h2>Four ideas, composed.</h2>
        <p>Each does one thing, through a well-defined interface, testable on its own.</p>
      </div>
      <div class="features">
        {
          features.map((f) => (
            <article class="card feature">
              <span class="feature__k">{f.k}</span>
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ░░ QUICKSTART ░░ -->
  <section class="section" id="quickstart">
    <div class="wrap qs">
      <div class="section__head">
        <span class="eyebrow">quickstart</span>
        <h2>Declare it. Watch it.</h2>
        <p>
          Tag a struct with where each value lives. mamori resolves, validates, and - with
          <code>Watch</code> - keeps it reconciled, handing you a diff-aware callback.
        </p>
      </div>
      <div class="qs__grid">
        <pre class="code"><code><span class="c">// One struct, many sources.</span>
<span class="k">type</span> <span class="t">Config</span> <span class="k">struct</span> {'{'}
  DBPassword <span class="t">secret.String</span> <span class="s">`source:"aws-sm://prod/db#password"`</span>
  LogLevel   <span class="t">string</span>        <span class="s">`source:"env:LOG_LEVEL" default:"info"`</span>
  Workers    <span class="t">int</span>           <span class="s">`source:"env:WORKERS" validate:"gte=1,lte=256"`</span>
  TLSCert    []<span class="t">byte</span>        <span class="s">`source:"file:///etc/tls/tls.crt"`</span>
{'}'}</code></pre>
        <pre class="code"><code><span class="c">// Watch: reconcile at runtime, react without restarting.</span>
w, _ := <span class="f">mamori.Watch</span>[<span class="t">Config</span>](ctx,
  <span class="f">mamori.OnChange</span>(<span class="k">func</span>(ev <span class="t">mamori.Change</span>[<span class="t">Config</span>]) {'{'}
    <span class="k">if</span> ev.<span class="f">Changed</span>(<span class="s">"DBPassword"</span>) {'{'}
      pool.<span class="f">Rotate</span>(ev.New.DBPassword.<span class="f">Reveal</span>())
    {'}'}
  {'}'}),
)
<span class="k">defer</span> w.<span class="f">Close</span>()

cfg := w.<span class="f">Get</span>() <span class="c">// lock-free; always the last valid config</span></code></pre>
      </div>
    </div>
  </section>

  <!-- ░░ PROVIDERS ░░ -->
  <section class="section" id="providers">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">provider ecosystem</span>
        <h2>Read from where your secrets already live.</h2>
        <p>
          {totalProviders} sources across {categories.length} categories, all behind one
          interface. Providers register with the <code>database/sql</code> pattern, the core has
          zero cloud-SDK dependencies, and every provider passes the{" "}
          <code>providertest</code> conformance kit.
        </p>
      </div>
      <div class="cats">
        {
          categories.map((c) => (
            <a class="card cat" href={c.href}>
              <div class="cat__top">
                <h3 class="cat__name">{c.name}</h3>
                <span class="cat__count">{c.count}</span>
              </div>
              <p class="cat__items">{c.items}</p>
            </a>
          ))
        }
      </div>
      <div class="providers__cta">
        <a class="btn btn--primary" href={`${base}docs/providers`}>Browse all providers →</a>
        <a class="btn btn--ghost" href={`${base}docs/writing-a-provider`}>Write your own</a>
      </div>
    </div>
  </section>

  <!-- ░░ MIDDLEWARE ░░ -->
  <section class="section" id="middleware">
    <div class="wrap mw">
      <div class="mw__copy">
        <span class="eyebrow">middleware</span>
        <h2>One interface, so it all composes.</h2>
        <p>
          Because every provider is a <code>Provider</code>, decorators nest freely. Cache to
          cut API cost, fail over to a replica, rate-limit a twitchy backend, audit every
          resolve, or rewrite refs per tenant.
        </p>
        <ul class="mw__list">
          <li><b>Cache</b> - memoize resolves for a TTL</li>
          <li><b>Failover</b> - primary, then replicas</li>
          <li><b>RateLimit</b> - protect rate-limited backends</li>
          <li><b>Audit</b> - log every access, never the payload</li>
          <li><b>Prefix</b> - multi-tenant namespace rewriting</li>
        </ul>
      </div>
      <pre class="code mw__code"><code><span class="f">mamori.WithProvider</span>(
  <span class="f">middleware.Cache</span>(5*time.Minute,
    <span class="f">middleware.Audit</span>(logger,
      <span class="f">middleware.Failover</span>(
        primarySM,
        replicaSM,
      ),
    ),
  ),
)</code></pre>
    </div>
  </section>

  <!-- ░░ OPERATIONAL LAYER ░░ -->
  <section class="section" id="operate">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">beyond loading</span>
        <h2>An operational layer, not just a loader.</h2>
        <p>
          Serve config to other services, inspect it from the CLI, probe its health in CI and
          at runtime, and hand it to your coding agent.
        </p>
      </div>
      <div class="features">
        {
          operational.map((o) => (
            <a class="card feature feature--link" href={o.href}>
              <h3>{o.t}</h3>
              <p>{o.d}</p>
              <span class="feature__cta">{o.cta} →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ░░ SECURITY ░░ -->
  <section class="section" id="security">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">security</span>
        <h2>Secret-safe by construction.</h2>
        <p>
          Every secret passes through your config code. That code also ends up in logs,
          errors, and bug reports. So these are on by default.
        </p>
      </div>
      <div class="sec">
        <article class="card"><h3>Secrets stay out of your logs</h3><p>Secrets have their own type. Print one and you get <code>[REDACTED]</code>. That holds in logs, in JSON, in errors, in a panic. Getting the real value takes an explicit call, so it is one word to grep for.</p></article>
        <article class="card"><h3>A leak fails the build</h3><p>mamori ships a <code>go vet</code> analyzer. Put a secret in a plain string and CI fails. Nobody has to catch it in review.</p></article>
        <article class="card"><h3>One secret cannot unlock another</h3><p>Running commands is off by default. A secret mamori resolved can never build the next lookup. Neither can your environment. So a leaked secret cannot point mamori somewhere new.</p></article>
        <article class="card"><h3>Honest about what it cannot do</h3><p>Wiping a secret from memory is best effort. Go's runtime cannot promise more, and we do not pretend otherwise. What we do promise is tested: no secret value ever reaches a log.</p></article>
      </div>
    </div>
  </section>

  <!-- ░░ CLOSING ░░ -->
  <section class="section closing">
    <div class="wrap closing__inner">
      <Omamori size={64} glow={true} />
      <h2>Give your config a guardian.</h2>
      <p>Typed. Watched. Reconciled. Runs in a Lambda, a systemd unit, or a Pod.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={docs}>Read the docs →</a>
        <a class="btn btn--ghost" href={repo} target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem) clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    /* minmax(0, ...) lets the columns shrink instead of the demo's min-content
       blowing the track (and the page) wider than the viewport. */
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 3rem;
    align-items: center;
  }
  .hero__title {
    font-size: var(--step-5);
    margin: 1.1rem 0 0;
  }
  .hero__title em {
    font-style: italic;
    color: var(--shu);
  }
  .hero__lede {
    color: var(--mist);
    font-size: var(--step-1);
    max-width: 42ch;
    margin-top: 1.4rem;
  }
  .hero__lede strong {
    color: var(--kinari);
  }
  .hero__lede em {
    font-style: normal;
    color: var(--kin);
  }
  .hero__cta {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.8rem;
    flex-wrap: wrap;
  }
  .hero__install {
    margin-top: 1.6rem;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--mist);
  }
  .hero__install code {
    background: var(--sumi);
    border: 1px solid var(--line);
    padding: 0.85rem 1.2rem;
    border-radius: 12px;
    display: inline-block;
  }
  .hero__install code::before {
    content: "$ ";
    color: var(--shu);
  }
  /* For humans / For agents toggle - sits below the lede so it never
     swaps the page title, only the action area beneath it. */
  .aud {
    display: inline-flex;
    gap: 0.2rem;
    padding: 0.25rem;
    margin: 2rem 0 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .hero__aud-intro {
    color: var(--mist);
    font-size: var(--step-0);
    max-width: 44ch;
    margin-top: 1.4rem;
  }
  .aud__btn {
    padding: 0.4rem 1.05rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--mist);
    font-family: var(--font-body);
    font-size: 0.9rem;
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .aud__btn--on {
    background: var(--shu);
    color: #fff;
  }
  .agent-card {
    margin-top: 1.6rem;
    padding: 1.4rem 1.5rem;
  }
  .agent-card__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mist-dim);
    margin: 0 0 0.5rem;
  }
  .agent-card .hero__install {
    margin: 0 0 1.1rem;
  }
  .agent-card .hero__install:last-of-type {
    margin-bottom: 1.2rem;
  }
  .agent-card .hero__install code {
    display: block;
  }
  .hero__install--prompt code::before {
    content: "";
  }
  .hero__install--prompt code {
    white-space: normal;
    font-size: 0.92rem;
    color: var(--kinari);
  }
  .agent-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    font-size: 0.9rem;
  }
  .agent-card__links a {
    color: var(--green-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .feature--link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .feature--link:hover {
    border-color: var(--green);
    transform: translateY(-2px);
  }
  .feature__cta {
    margin-top: auto;
    padding-top: 0.9rem;
    color: var(--green-deep);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  /* Collapse to one column before the two-column layout gets too cramped for the
     demo card (its min-content is ~430px). Below this the demo follows the copy:
     eyebrow, title, lede, CTAs, go get, then the animation. */
  @media (max-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__demo {
      order: 0;
      margin-top: 0.5rem;
    }
  }

  /* FEATURES */
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.1rem;
  }
  .feature__k {
    font-family: var(--font-mono);
    color: var(--shu);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }
  .feature h3 {
    font-size: var(--step-1);
    margin: 0.6rem 0 0.5rem;
  }
  .feature p {
    color: var(--mist);
    font-size: 0.95rem;
    margin: 0;
  }

  /* QUICKSTART */
  .qs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }
  .qs__grid pre {
    font-size: 0.95rem;
  }

  /* PROVIDERS (category summary) */
  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }
  .cat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.3rem 1.4rem;
    text-decoration: none;
  }
  .cat__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .cat__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0;
    color: var(--ink);
  }
  .cat__count {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--green-deep);
    background: var(--green-soft);
    border: 1px solid rgba(47, 158, 104, 0.3);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
  .cat__items {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .providers__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  /* MIDDLEWARE */
  .mw {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .mw__copy p {
    color: var(--mist);
  }
  .mw__list {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--mist);
  }
  .mw__list li {
    padding-left: 1.2rem;
    position: relative;
  }
  .mw__list li::before {
    content: "▸";
    color: var(--shu);
    position: absolute;
    left: 0;
  }
  .mw__list b {
    color: var(--kinari);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .mw__code {
    font-size: 0.92rem;
  }
  @media (max-width: 860px) {
    .mw {
      grid-template-columns: 1fr;
    }
  }

  /* SECURITY */
  .sec {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.1rem;
  }
  .sec h3 {
    font-size: var(--step-1);
    margin-bottom: 0.5rem;
    color: var(--kin);
  }
  .sec p {
    color: var(--mist);
    font-size: 0.92rem;
    margin: 0;
  }

  /* CLOSING */
  .closing {
    text-align: center;
  }
  .closing__inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .closing h2 {
    font-size: var(--step-3);
    margin-top: 0.5rem;
  }
  .closing p {
    color: var(--mist);
    max-width: 40ch;
    margin: 0;
  }
  .closing .hero__cta {
    justify-content: center;
  }
</style>

<script>
  // Hero "For humans / For agents" toggle: swap the copy panel, no navigation.
  const audBtns = document.querySelectorAll("[data-aud-btn]");
  const audPanels = document.querySelectorAll<HTMLElement>("[data-aud-panel]");
  audBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const which = btn.getAttribute("data-aud-btn");
      audBtns.forEach((b) => {
        const on = b === btn;
        b.classList.toggle("aud__btn--on", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
      audPanels.forEach((p) => {
        p.hidden = p.getAttribute("data-aud-panel") !== which;
      });
    });
  });
</script>
